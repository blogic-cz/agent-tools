{
  "name": "@blogic-cz/agent-tools",
  "version": "0.8.11",
  "description": "CLI tools for AI coding agent workflows — GitHub, database, Kubernetes, Azure DevOps, logs, sessions, and audit",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "database",
    "devops",
    "github",
    "kubernetes",
    "tools"
  ],
  "homepage": "https://github.com/blogic-cz/agent-tools#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blogic-cz/agent-tools.git"
  },
  "bin": {
    "agent-tools-audit": "./src/audit-tool/index.ts",
    "agent-tools-az": "./src/az-tool/index.ts",
    "agent-tools-db": "./src/db-tool/index.ts",
    "agent-tools-gh": "./src/gh-tool/index.ts",
    "agent-tools-k8s": "./src/k8s-tool/index.ts",
    "agent-tools-logs": "./src/logs-tool/index.ts",
    "agent-tools-session": "./src/session-tool/index.ts",
    "audit-tool": "./src/audit-tool/index.ts",
    "az-tool": "./src/az-tool/index.ts",
    "db-tool": "./src/db-tool/index.ts",
    "gh-tool": "./src/gh-tool/index.ts",
    "k8s-tool": "./src/k8s-tool/index.ts",
    "logs-tool": "./src/logs-tool/index.ts",
    "session-tool": "./src/session-tool/index.ts"
  },
  "files": [
    "src/",
    "dist/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./src/shared/index.ts"
    },
    "#shared/*": {
      "types": "./dist/shared/*.d.ts",
      "default": "./src/shared/*.ts"
    },
    "#config": {
      "types": "./dist/config/index.d.ts",
      "default": "./src/config/index.ts"
    },
    "#config/*": {
      "types": "./dist/config/*.d.ts",
      "default": "./src/config/*.ts"
    },
    "#gh/*": {
      "types": "./dist/gh-tool/*.d.ts",
      "default": "./src/gh-tool/*.ts"
    },
    "#k8s/*": {
      "types": "./dist/k8s-tool/*.d.ts",
      "default": "./src/k8s-tool/*.ts"
    },
    "#db/*": {
      "types": "./dist/db-tool/*.d.ts",
      "default": "./src/db-tool/*.ts"
    },
    "#logs/*": {
      "types": "./dist/logs-tool/*.d.ts",
      "default": "./src/logs-tool/*.ts"
    },
    "#az/*": {
      "types": "./dist/az-tool/*.d.ts",
      "default": "./src/az-tool/*.ts"
    },
    "#guard": {
      "types": "./dist/credential-guard/index.d.ts",
      "default": "./src/credential-guard/index.ts"
    },
    "#session/*": {
      "types": "./dist/session-tool/*.d.ts",
      "default": "./src/session-tool/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./credential-guard": {
      "types": "./dist/credential-guard/index.d.ts",
      "default": "./src/credential-guard/index.ts"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./src/config/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.declarations.json",
    "check": "bun check.ts",
    "check:ci": "bun check.ts ci",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c ./.oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint -c ./.oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.25",
    "@toon-format/toon": "2.1.0",
    "effect": "4.0.0-beta.25"
  },
  "devDependencies": {
    "@effect/language-service": "0.77.0",
    "@effect/vitest": "4.0.0-beta.25",
    "@types/bun": "1.3.9",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
