{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // Not redundant with the package "imports" map. These paths shadow it during
    // our own build, so build:types resolves "#" specifiers to src while the
    // "types" conditions in "imports" still point at a dist that does not exist
    // yet. Delete this block and build:types stops resolving. Keep it in sync
    // with "imports" in package.json.
    "paths": {
      "#shared": ["./src/shared/index.ts"],
      "#shared/*": ["./src/shared/*"],
      "#config": ["./src/config/index.ts"],
      "#config/*": ["./src/config/*"],
      "#gh/*": ["./src/gh-tool/*"],
      "#k8s/*": ["./src/k8s-tool/*"],
      "#db/*": ["./src/db-tool/*"],
      "#observability/*": ["./src/observability-tool/*"],
      "#logs/*": ["./src/logs-tool/*"],
      "#az/*": ["./src/az-tool/*"],
      "#azdo/*": ["./src/azdo-tool/*"],
      "#guard": ["./src/credential-guard/index.ts"],
      "#session/*": ["./src/session-tool/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
