{
  "plugins": ["import", "jsx-a11y", "node", "oxc", "promise", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    "eslint/array-callback-return": "error",
    "eslint/default-param-last": "error",
    "eslint/eqeqeq": "error",
    "eslint/no-else-return": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error",
    "eslint/require-await": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-template-curly-in-string": "error",
    "eslint/no-var": "error",
    "eslint/no-underscore-dangle": "off",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-relative-parent-imports": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignoreBooleanCoercion": true,
        "ignorePrimitives": {
          "boolean": true
        }
      }
    ],
    "unicorn/error-message": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/throw-new-error": "off",
    "unicorn/require-module-specifiers": "off",
    "vitest/no-import-node-test": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/credential-guard/**",
              "!**/credential-guard/index",
              "!**/credential-guard/index.ts"
            ],
            "message": "Import the public credential-guard index. Private policy modules stay inside credential-guard."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/gh-tool/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/read/api", "#gh/read/api"],
                "importNames": ["githubApi"],
                "message": "Raw GitHub HTTP belongs inside gh-tool/read."
              },
              {
                "group": [
                  "**/credential-guard/**",
                  "!**/credential-guard/index",
                  "!**/credential-guard/index.ts"
                ],
                "message": "Import the public credential-guard index. Private policy modules stay inside credential-guard."
              }
            ]
          }
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "property": "runGh",
            "message": "Use a typed read or writes operation from gh-tool/read."
          },
          {
            "property": "runGhJson",
            "message": "Use a typed read or writes operation from gh-tool/read."
          },
          {
            "property": "runGraphQL",
            "message": "Use a typed read or writes operation from gh-tool/read."
          },
          {
            "property": "apiRequest",
            "message": "Use a typed read or writes operation from gh-tool/read."
          }
        ]
      }
    },
    {
      "files": ["src/gh-tool/read/**/*.ts"],
      "rules": {
        "eslint/no-restricted-properties": "off",
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/credential-guard/**",
                  "!**/credential-guard/index",
                  "!**/credential-guard/index.ts"
                ],
                "message": "Import the public credential-guard index. Private policy modules stay inside credential-guard."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**", "**/e2e/**"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "eslint/no-empty-function": "off",
        "eslint/no-promise-executor-return": "off",
        "eslint/no-shadow": "off",
        "eslint/require-await": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/no-conditional-tests": "off",
        "vitest/no-disabled-tests": "off",
        "vitest/expect-expect": "off",
        "vitest/no-standalone-expect": "off",
        "vitest/require-to-throw-message": "off",
        "unicorn/no-array-sort": "off",
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": ["apps/web-app/src/routes/**"],
      "rules": {
        "typescript/only-throw-error": "off"
      }
    },
    {
      "files": ["src/credential-guard/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["tests/**/*.ts", "scripts/**/*.test.ts", "src/**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "message": "Tests must run in-process. Inject the external process runner."
              },
              {
                "name": "child_process",
                "message": "Tests must run in-process. Inject the external process runner."
              },
              {
                "name": "node:worker_threads",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "worker_threads",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "node:cluster",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "cluster",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              }
            ],
            "patterns": [
              {
                "group": ["bun"],
                "importNames": ["spawn", "spawnSync", "$", "Worker"],
                "message": "Tests must run in-process. Inject the external process runner."
              }
            ]
          }
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Bun",
            "property": "spawn",
            "message": "Tests must run in-process. Inject the external process runner."
          },
          {
            "object": "Bun",
            "property": "spawnSync",
            "message": "Tests must run in-process. Inject the external process runner."
          },
          {
            "object": "Bun",
            "property": "$",
            "message": "Tests must run in-process. Inject the external process runner."
          },
          {
            "object": "process",
            "property": "execPath",
            "message": "Tests must run in-process. Call the real command program."
          },
          {
            "property": "Worker",
            "message": "Tests must run in-process. Inject the external process or worker runner."
          }
        ],
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "Worker",
            "message": "Tests must run in-process. Inject the external process or worker runner."
          },
          {
            "name": "eval",
            "message": "Tests must run in-process. Inject the external process or worker runner."
          },
          {
            "name": "Function",
            "message": "Tests must run in-process. Inject the external process or worker runner."
          }
        ],
        "eslint/no-restricted-modules": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "child_process",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "node:worker_threads",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "worker_threads",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "node:cluster",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              },
              {
                "name": "cluster",
                "message": "Tests must run in-process. Inject the external process or worker runner."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/setup/no-network.ts", "tests/runtime-guard.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "eslint/no-restricted-globals": "off",
        "eslint/no-restricted-modules": "off",
        "eslint/no-restricted-properties": "off"
      }
    }
  ]
}
